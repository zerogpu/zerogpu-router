{
  "name": "zerogpu-router",
  "version": "3.0.1",
  "description": "ZeroGPU Router plugin for OpenClaw: route your AI tasks (summarize, classify, redact PII, extract JSON, chat) to open-weight and small language models via the zerogpu CLI. OpenAI-compatible and pay-as-you-go — cuts agent inference costs without changing your reasoning model.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json"
  ],
  "author": {
    "name": "ZeroGPU",
    "email": "hello@zerogpu.ai",
    "url": "https://zerogpu.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zerogpu/zerogpu-router.git",
    "directory": "agents/openclaw/plugin"
  },
  "bugs": {
    "url": "https://github.com/zerogpu/zerogpu-router/issues",
    "email": "hello@zerogpu.ai"
  },
  "homepage": "https://zerogpu.ai",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agent-plugin",
    "zerogpu",
    "cost-optimization",
    "model-routing",
    "open-weight-models",
    "small-language-models",
    "openai-compatible",
    "classification",
    "pii-redaction",
    "summarization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  },
  "devDependencies": {
    "openclaw": "^2026.7.1",
    "typescript": "^5.0.0"
  }
}
