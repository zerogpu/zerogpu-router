#!/usr/bin/env bash
# scripts/openclaw-release [patch|minor|major]  — releases the OpenClaw plugin (agents/openclaw)
#
# Bumps agents/openclaw/plugin/{package.json,openclaw.plugin.json} (+ syncs the plugin
# lockfile), commits, pushes to origin/main, then tags `zerogpu-openclaw-plugin--v<new>` and
# pushes it. The tag fires .github/workflows/openclaw-plugin-release.yml, which creates the
# GitHub release and publishes the `zerogpu-router` code-plugin to ClawHub.
# See docs/OPENCLAW_PLUGIN_RELEASE_GUIDE.md.
#
# Run from anywhere in the repo; paths resolve against the git root. Default bump: patch.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ -n "$(git status --porcelain)" ]; then
  echo "error: working tree is dirty — commit or stash first"
  exit 1
fi

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "$CURRENT_BRANCH" != "main" ]; then
  echo "error: must be on 'main' to release"
  exit 1
fi

git fetch --no-tags origin main

LOCAL="$(git rev-parse HEAD)"
REMOTE="$(git rev-parse origin/main)"

if [ "$LOCAL" != "$REMOTE" ]; then
  echo "error: local main is not in sync with origin/main"
  echo "  local:  $LOCAL"
  echo "  remote: $REMOTE"
  exit 1
fi

BUMP="${1:-patch}"
case "$BUMP" in
  patch|minor|major) ;;
  *)
    echo "error: bump must be patch|minor|major"
    exit 1
    ;;
esac

PLUGIN_DIR="agents/openclaw/plugin"
PKG="$PLUGIN_DIR/package.json"
PLUGIN_JSON="$PLUGIN_DIR/openclaw.plugin.json"
CHANGELOG="agents/openclaw/CHANGELOG.md"

command -v jq  >/dev/null || { echo "error: jq is required"; exit 1; }
command -v npm >/dev/null || { echo "error: npm is required (used to sync the plugin lockfile)"; exit 1; }

CURRENT="$(jq -r .version "$PKG")"
IFS='.' read -r MAJOR MINOR PATCH <<<"$CURRENT"

case "$BUMP" in
  major) MAJOR=$((MAJOR+1)); MINOR=0; PATCH=0 ;;
  minor) MINOR=$((MINOR+1)); PATCH=0 ;;
  patch) PATCH=$((PATCH+1)) ;;
esac

NEW="${MAJOR}.${MINOR}.${PATCH}"
TAG="zerogpu-openclaw-plugin--v${NEW}"

# Check tag
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
  echo "error: tag $TAG already exists locally"
  exit 1
fi

if git ls-remote --exit-code --tags origin "refs/tags/$TAG" >/dev/null 2>&1; then
  echo "error: tag $TAG already exists on origin"
  exit 1
fi

echo "Releasing OpenClaw plugin: $CURRENT -> $NEW"

# Require a CHANGELOG heading for the new version. The release workflow slices this section
# into the GitHub release body, so releasing without it is never correct — fail hard here
# rather than pushing a commit/tag the release workflow would reject.
if ! grep -Eq "^##[[:space:]]+${NEW}([[:space:]]|$)" "$CHANGELOG"; then
  echo "error: no '## $NEW' heading found in $CHANGELOG" >&2
  echo "  Add a '## $NEW' section describing what shipped, commit it, then re-run." >&2
  exit 1
fi

# Update versions
tmp="$(mktemp)"
jq --arg v "$NEW" '.version = $v' "$PKG" >"$tmp" && mv "$tmp" "$PKG"

tmp="$(mktemp)"
jq --arg v "$NEW" '.version = $v' "$PLUGIN_JSON" >"$tmp" && mv "$tmp" "$PLUGIN_JSON"

# Keep the plugin lockfile version in sync with package.json so CI `npm ci` does not fail.
npm --prefix "$PLUGIN_DIR" install --package-lock-only >/dev/null

git add "$PKG" "$PLUGIN_JSON" "$PLUGIN_DIR/package-lock.json"
git commit -m "openclaw: release v${NEW}"
git push origin main

git tag "$TAG"
git push origin "$TAG"

echo "Released $TAG"