# --- Node stdio (local plugin) credentials ---
# Used by `npm start` / the Node entry (src/index.ts).
# These are NOT consumed by the Cloudflare Worker — see below.
ZEROGPU_ORCHESTRATION_URL=https://api.example.zerogpu.ai
ZEROGPU_API_KEY=replace-me
ZEROGPU_PROJECT_ID=replace-me

# --- Cloudflare Worker configuration ---
# The Worker only needs the orchestration URL as a secret:
#   wrangler secret put ZEROGPU_ORCHESTRATION_URL --env develop
# ZEROGPU_API_KEY and ZEROGPU_PROJECT_ID are sent by the client on each MCP
# request as HTTP headers:
#   x-api-key:     <your ZeroGPU API key>
#   x-project-id:  <your ZeroGPU project ID>

# --- Optional: bearer used ONLY by `wrangler dev` for local Worker smoke tests. ---
# In deployed Workers, this is set via `wrangler secret put ZEROGPU_MCP_BEARER`.
# ZEROGPU_MCP_BEARER=some-long-random-string

# --- Optional live test toggle (hits the real ZeroGPU backend) ---
# ZEROGPU_LIVE=1
