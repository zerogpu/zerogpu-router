# --- Required ---
ZEROGPU_ORCHESTRATION_URL=https://api.example.zerogpu.ai
ZEROGPU_API_KEY=replace-me
ZEROGPU_PROJECT_ID=replace-me

# --- Optional transport config ---
# stdio (default) or http
ZEROGPU_MCP_TRANSPORT=stdio
ZEROGPU_MCP_HTTP_PORT=3987
ZEROGPU_MCP_HTTP_HOST=127.0.0.1
# Required when HTTP host is not 127.0.0.1
# ZEROGPU_MCP_HTTP_BEARER=some-long-random-string

# --- Optional live test toggle ---
# ZEROGPU_LIVE=1
