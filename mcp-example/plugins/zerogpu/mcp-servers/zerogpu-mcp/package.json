{
  "name": "zerogpu-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes the ZeroGPU Orchestration API as task-centric tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zerogpu-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env dist/index.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "msw": "^2.6.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
