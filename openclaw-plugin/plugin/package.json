{
  "name": "openclaw-plugin-zerogpu",
  "version": "0.1.1",
  "description": "OpenClaw plugin: offload cheap AI tasks to the ZeroGPU MCP server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zerogpu/ZeroGPU-Router.git",
    "directory": "openclaw-plugin/plugin"
  },
  "bugs": {
    "url": "https://github.com/zerogpu/ZeroGPU-Router/issues"
  },
  "homepage": "https://github.com/zerogpu/ZeroGPU-Router/tree/main/openclaw-plugin#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "mcp",
    "zerogpu",
    "model-routing",
    "cost-optimization",
    "agent-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.0",
      "minGatewayVersion": ">=2026.4.0"
    },
    "build": {
      "openclawVersion": "2026.4.27",
      "pluginSdkVersion": "2026.4.27"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.0"
  },
  "devDependencies": {
    "openclaw": "^2026.4.27",
    "typescript": "^5.0.0"
  }
}
